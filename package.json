{
  "name": "acousticalc-audio-analysis",
  "version": "1.0.3",
  "description": "Essentia.js Web Worker for musical key, tempo, and chord analysis",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist/",
    "src/",
    "build.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --fileParallelism=false",
    "test:k6": "vitest run test/acceptance.test.ts -t K6"
  },
  "dependencies": {
    "essentia.js": "0.1.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
